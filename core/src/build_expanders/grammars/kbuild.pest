// Makefile.pest
// Linux-kernel Kbuild / Makefile subset

// ——————————————————————————————————————————————————————————
// 0. Implicit whitespace & comments
// mark these silent so they don’t appear in the parse tree
WHITESPACE     = _{ " " | "\t" }
COMMENT        = _{ "#" ~ (!"\n" ~ ANY)* }
NEWLINE        = _{ WHITESPACE* ~ COMMENT? ~ "\n" }
NEWLINE_OR_EOI = _{ NEWLINE | EOI }

// ——————————————————————————————————————————————————————————
// 1. Top-level
file = ${ SOI ~ line* ~ EOI }
line = _{
    command_line
  | (WHITESPACE* ~ (blank_line | export_stmt | unexport_stmt | define_stmt | include_stmt | variability_block | list_assignment | function_stmt | assignment | no_op_target | target))
}

export_stmt = {
    "export" ~ (!NEWLINE ~ ANY)* ~ NEWLINE_OR_EOI
}

unexport_stmt = {
    "unexport" ~ (!NEWLINE ~ ANY)* ~ NEWLINE_OR_EOI
}

function_stmt = _{
    var_expansion // the initial "$(foreach …)"
  ~ assignment_value // eat all the rest (including continuation+newline)
  ~ NEWLINE
}

// ——————————————————————————————————————————————————————————
// 2. Blank lines & comments
blank_line = _{ (WHITESPACE | COMMENT)* ~ NEWLINE }

// ——————————————————————————————————————————————————————————
// 3. Include
include_stmt =  { "-"? ~ "include " ~ path ~ NEWLINE }
path         = @{ (!NEWLINE ~ ANY)+ }

// ——————————————————————————————————————————————————————————
// 4. Variability / conditional blocks

variability_block = ${
    variability_block_command ~ WHITESPACE ~ variability_expression ~ NEWLINE ~ variability_block_body ~ (WHITESPACE | NEWLINE)* ~ else_block? ~ (WHITESPACE | NEWLINE)* ~ "endif"
}

else_block = {
    "else" ~ WHITESPACE* ~ NEWLINE ~ line*
}

variability_block_command = {
    "ifdef"
  | "ifeq"
  | "ifndef"
  | "ifneq"
}

variability_expression = {
    (!NEWLINE ~ ANY)*
}

variability_block_body = {
    line*
}

// ——————————————————————————————————————————————————————————
// 5. List assignments (obj-y, drivers-m, etc.)

ws_cont = _{ WHITESPACE+ | continuation }

list_assignment = {
    list_name ~ ws_cont* ~ assignment_op ~ ws_cont* ~ list_value ~ NEWLINE_OR_EOI
}

// list-names like "obj-y", "drivers-m", "lib-objs", etc.
list_name = ${
    ASCII_ALPHANUMERIC+ ~ "-" ~ (var_expansion | "y" | "m" | "objs")
}

// the RHS: a sequence of .o files, subdirs, or variable refs
list_value =  { (list_item ~ WS?)+ }
list_item  = _{ object_filename | subdir | var_expansion }

object_filename = @{ "<generated>"? ~ (ASCII_ALPHANUMERIC | "-" | "_" | "/")* ~ ".o" }
subdir          = @{ (ASCII_ALPHANUMERIC | "-" | "_" | "/")* ~ "/" }

// ——————————————————————————————————————————————————————————
// 6. Generic variable assignments

assignment       =  {
    var_name ~ ws_cont* ~ assignment_op ~ ws_cont* ~ assignment_value ~ NEWLINE_OR_EOI
}
var_name         = @{ (var_expansion | ident | "%" | ".")+ }
assignment_op    = @{ ":=" | "+=" | "?=" | "=" }
assignment_value = @{ (continuation | (!NEWLINE ~ ANY))* }
continuation     = @{ "\\" ~ NEWLINE ~ WHITESPACE* }

// simple identifiers
ident = @{ (ASCII_ALPHANUMERIC | "-" | "_" | "." | "/")+ }

// ——————————————————————————————————————————————————————————
// 7. Variable expansion

var_expansion = @{
    "$(" ~ var_inner* ~ ")" // atomic, so we grab the entire nested expansion

  | "${" ~ var_inner* ~ "}"
}

// everything that can appear inside a $()/ ${}: either another nested expansion,
// or any single character except the matching closing brace/paren
var_inner = _{ var_expansion | !(")" | "}") ~ ANY }

// ——————————————————————————————————————————————————————————
// 8. Stubbed targets (Kbuild doesn’t really use them, but just in case)

// E.g. `.config .kconfig.d: ;`
no_op_target = ${
    var_name ~ (WHITESPACE+ ~ var_name)* ~ WHITESPACE* ~ ":" ~ WHITESPACE+ ~ ";" ~ NEWLINE_OR_EOI
}

// A target with zero-or-more prerequisites, then zero-or-more indented recipe lines
target = ${
    var_name ~ (WHITESPACE+ ~ var_name)* // "TAGS" or "$(obj)/foo.o" etc.
  ~ WS* ~ ":" // the separator
  // zero or more prerequisites
  ~ (!NEWLINE_OR_EOI ~ ANY)* ~ NEWLINE_OR_EOI // end of the rule‐head
  // now any number of recipe lines (each one must start with a tab)
}

// A recipe line must start with a TAB, then the shell command, then a newline
command_line = @{ "\t" ~ (!NEWLINE ~ ANY)* ~ NEWLINE_OR_EOI }

// ——————————————————————————————————————————————————————————
// 9. Helpers

define_stmt = {
    SOI? // optional start-of-input (if you want to allow multiple stmts)
  ~ "define" ~ WHITESPACE+ ~ var_name ~ NEWLINE ~ define_body ~ "endef" ~ NEWLINE_OR_EOI
}

define_body = _{
    (!("endef") ~ ANY)* // anything up until the literal "endef"
}

ASCII_ALPHANUMERIC = _{ 'a'..'z' | 'A'..'Z' | '0'..'9' }
WS                 = _{ WHITESPACE+ }

// `SOI` and `EOI` are built-in Pest rules for start/end of input
