{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "tree_sitter_preproc",
      "camelcase": "TreeSitterPreproc",
      "title": "Tree-Sitter C Preprocessor Parser",
      "scope": "source.tree_sitter_preproc",
      "file-types": [
        ".c",
        ".cpp",
        ".h",
        ".hpp"
      ],
      "injection-regex": "^tree_sitter_preproc$",
      "class-name": "TreeSitterTreeSitterPreproc"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "A minimal parser for reading C-style preprocessor macros",
    "authors": [
      {
        "name": "Anonymous for revision",
        "email": "anonymous@example.com",
        "url": "https://example.com/"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-tree_sitter_preproc"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
